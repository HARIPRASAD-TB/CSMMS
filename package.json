{
  "name": "buildconnect",
  "version": "1.0.0",
  "description": "Construction marketplace — hire workers, book contractors, and buy building materials",
  "private": true,
  "homepage": "https://HARIPRASAD-TB.github.io/CSMMS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh": "node scripts/prepare-gh-pages.mjs clean && node scripts/prepare-gh-pages.mjs hide && cross-env GITHUB_PAGES=true next build && node scripts/prepare-gh-pages.mjs postbuild && node scripts/prepare-gh-pages.mjs restore",
    "start": "next start",
    "lint": "eslint",
    "predeploy": "npm run build:gh",
    "deploy": "gh-pages -d out"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "mongoose": "^8.24.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
